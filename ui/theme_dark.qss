/* Gahan AI Validation Viewer: dark theme. bg #16181D, panels #1E2127, text #E6E6E6, accent #7A1F1F / hover #952828 */
QWidget { background: #16181D; color: #E6E6E6; font-size: 10pt; }
QMainWindow::separator { background: #2A2E36; width: 3px; height: 3px; }
QDockWidget { titlebar-close-icon: none; }
QDockWidget::title { background: #1E2127; padding: 4px 8px; color: #9AA0AA; font-weight: 600; }
#Panel, QDockWidget > QWidget { background: #1E2127; }
#Header { background: #111317; border-bottom: 1px solid #2A2E36; }
#HeaderTitle { font-size: 13pt; font-weight: 600; background: transparent; }
#HeaderModel, #HeaderDevice { color: #9AA0AA; background: transparent; }
#HeaderDevice[gpu="true"] { color: #6EE7A0; }
#SectionTitle { color: #9AA0AA; font-size: 8.5pt; font-weight: 700; letter-spacing: 1px; background: transparent;
                padding-top: 8px; }
QLabel { background: transparent; }
QGroupBox { border: 1px solid #2A2E36; border-radius: 4px; margin-top: 10px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #9AA0AA; }
QPushButton { background: #2A2E36; border: 1px solid #343944; border-radius: 4px; padding: 5px 12px; }
QPushButton:hover { background: #343944; }
QPushButton:pressed { background: #7A1F1F; border-color: #B03030; }
QPushButton:disabled { color: #5C626C; background: #20232A; border-color: #2A2E36; }
QPushButton#Primary { background: #7A1F1F; border-color: #952828; font-weight: 600; }
QPushButton#Primary:hover { background: #952828; }
QPushButton#Primary:disabled { background: #3A2222; color: #8C7A7A; }
QPushButton#Flag { color: #F2B8B8; }
QToolButton { background: #2A2E36; border: 1px solid #343944; border-radius: 4px; padding: 3px 6px; }
QToolButton:hover { background: #343944; }
QToolButton:pressed { background: #7A1F1F; border-color: #B03030; }
QToolButton:disabled { color: #5C626C; background: #20232A; border-color: #2A2E36; }
QToolButton:checked { background: #7A1F1F; border-color: #952828; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background: #111317; border: 1px solid #343944; border-radius: 4px; padding: 3px 6px;
    selection-background-color: #7A1F1F; }
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border-color: #952828; }
QComboBox QAbstractItemView { background: #1E2127; selection-background-color: #7A1F1F; border: 1px solid #343944; }
QCheckBox, QRadioButton { spacing: 6px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; }
QCheckBox::indicator:unchecked { border: 1px solid #4A505B; background: #111317; border-radius: 3px; }
QCheckBox::indicator:checked { border: 1px solid #952828; background: #7A1F1F; border-radius: 3px;
                               image: url({UI}/icons/check.svg); }
QRadioButton::indicator:unchecked { border: 1px solid #4A505B; background: #111317; border-radius: 8px; }
QRadioButton::indicator:checked { border: 4px solid #952828; background: #E6E6E6; border-radius: 8px; width: 8px; height: 8px; }
QSlider::groove:horizontal { height: 4px; background: #343944; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #7A1F1F; border-radius: 2px; }
QSlider::handle:horizontal { background: #E6E6E6; border: 2px solid #952828; width: 12px; height: 12px;
                             margin: -6px 0; border-radius: 8px; }
QSlider::handle:horizontal:hover { background: #FFFFFF; border-color: #B03030; }
QTableWidget, QTreeWidget, QListWidget { background: #1E2127; alternate-background-color: #22252C;
    gridline-color: #2A2E36; border: none; selection-background-color: #7A1F1F; }
QHeaderView::section { background: #1E2127; color: #9AA0AA; border: none; border-bottom: 1px solid #2A2E36;
                       padding: 3px 6px; font-weight: 600; }
QScrollBar:vertical { background: #16181D; width: 10px; }
QScrollBar::handle:vertical { background: #343944; border-radius: 4px; min-height: 24px; }
QScrollBar:horizontal { background: #16181D; height: 10px; }
QScrollBar::handle:horizontal { background: #343944; border-radius: 4px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QMenuBar { background: #111317; }
QMenuBar::item:selected, QMenu::item:selected { background: #7A1F1F; }
QMenu { background: #1E2127; border: 1px solid #343944; }
QToolTip { background: #1E2127; color: #E6E6E6; border: 1px solid #343944; padding: 4px; }
QStatusBar { background: #111317; color: #9AA0AA; }
QTabWidget::pane { border: 1px solid #2A2E36; }
QTabBar::tab { background: #1E2127; padding: 5px 12px; border: 1px solid #2A2E36; }
QTabBar::tab:selected { background: #7A1F1F; }
#LiveView { background: #0C0D10; }
#Badge { border-radius: 3px; padding: 1px 6px; font-weight: 700; }
